{
  "name": "@deepseek-ai/dsh-enterprise-app",
  "description": "The dsh enterprise-surface bundle: enterprise platform-user authentication patch layer over dsh-web-app",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/enterprise-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-platform-user": "workspace:*",
    "@deepseek-ai/dsh-platform-user-console": "workspace:*",
    "@deepseek-ai/dsh-platform-user-api": "workspace:*",
    "@deepseek-ai/dsh-user-identity-context": "workspace:*",
    "@deepseek-ai/dsh-flowable-task-proxy": "workspace:*",
    "@deepseek-ai/cordis-plugin-logger-console": "workspace:~",
    "@deepseek-ai/dsh-skill-sync": "workspace:*",
    "@deepseek-ai/dsh-knowledge": "workspace:*",
    "@deepseek-ai/dsh-kb-context": "workspace:*",
    "@deepseek-ai/dsh-process-start": "workspace:*",
    "@deepseek-ai/dsh-llm-access": "workspace:*",
    "@deepseek-ai/dsh-session-delete": "workspace:*",
    "@deepseek-ai/dsh-pocket-access": "workspace:*",
    "@deepseek-ai/dsh-host-directory-picker-browse": "workspace:*",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "workspace:*",
    "@deepseek-ai/dsh-client-ui-enterprise": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
